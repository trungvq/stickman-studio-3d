{
  "name": "stickman-studio-3d",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @stickman3d/rig build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "shots": "pnpm --filter @stickman3d/rig build && node tools/shots.mjs",
    "bench": "pnpm --filter @stickman3d/rig build && node tools/bench.mjs",
    "release": "pnpm build && pnpm -r publish --no-git-checks"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  }
}
